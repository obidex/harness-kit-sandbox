{
  "$schema": "https://raw.githubusercontent.com/obidex/harness-kit/main/.harness/settings.schema.json",
  "repository": {
    "allow_auto_merge": true,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "delete_branch_on_merge": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "BLANK"
  },
  "rulesets": [
    {
      "name": "main-protection",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH"
          ],
          "exclude": []
        }
      },
      "bypass_actors": [],
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": false,
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": false,
            "allowed_merge_methods": [
              "squash"
            ]
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "required_status_checks": [
              {
                "context": "ci"
              },
              {
                "context": "harness-audit"
              }
            ]
          }
        }
      ]
    }
  ],
  "labels": [
    {
      "name": "blocker",
      "color": "b60205",
      "description": "Blocks the merge (build floor, C11)"
    },
    {
      "name": "major",
      "color": "d93f0b",
      "description": "Must be fixed before release (C11)"
    },
    {
      "name": "minor",
      "color": "fbca04",
      "description": "Logged; fix when convenient (C11)"
    },
    {
      "name": "inbox",
      "color": "5319e7",
      "description": "Cross-project request (Harness Kit inbox)"
    }
  ]
}
